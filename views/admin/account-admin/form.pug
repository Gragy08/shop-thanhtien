extends ../../layouts/admin.pug

block main
  .row.justify-content-center
    .col-12
      .mb-4
        h1.h3.mt-3.mb-1 #{formTitle}
        p.text-muted.mb-0 Phân quyền truy cập theo vai trò trong hệ thống.
      .card.border-0.shadow-sm
        .card-body.p-4
          form#accountAdminForm(data-id=account ? account._id : "", data-edit=isEdit ? "true" : "false")
            .row.g-3
              .col-md-6
                label.form-label(for="fullName") Họ tên
                input#fullName.form-control(name="fullName", required, value=account ? account.fullName : "")
              .col-md-6
                label.form-label(for="email") Email
                input#email.form-control(name="email", type="email", required, value=account ? account.email : "")
              if !isEdit
                .col-md-6
                  label.form-label(for="password") Mật khẩu
                  input#password.form-control(name="password", type="password", minlength="12", required)
              .col-md-6
                label.form-label(for="role") Vai trò
                select#role.form-select(name="role", required)
                  option(value="admin", selected=account && account.role === "admin") Admin
                  option(value="manager", selected=account && account.role === "manager") Manager
              .col-md-6
                label.form-label(for="status") Trạng thái
                select#status.form-select(name="status")
                  option(value="active", selected=!account || account.status === "active") Hoạt động
                  option(value="inactive", selected=account && account.status === "inactive") Tạm dừng
            .d-flex.justify-content-between.align-items-center.mt-4
              if isEdit
                button#changePasswordButton.btn.btn-outline-secondary(type="button") Đổi mật khẩu
              else
                span
              .d-flex.gap-2
                a.btn.btn-light(href="/admin/account-admin/list") Hủy
                button.btn.btn-primary(type="submit") Lưu tài khoản
            p#accountMessage.form-message.mt-3.mb-0(role="alert")
          if isEdit
            form#changePasswordForm.d-none.mt-4.border-top.pt-4(data-id=account._id)
              h2.h6 Đổi mật khẩu
              .input-group
                input.form-control(name="password", type="password", minlength="12", required, placeholder="Mật khẩu mới, tối thiểu 12 ký tự")
                button.btn.btn-outline-primary(type="submit") Cập nhật
              p#passwordMessage.form-message.mt-2.mb-0(role="alert")

block script
  script(src="/admin/assets/js/account-admin.js")
