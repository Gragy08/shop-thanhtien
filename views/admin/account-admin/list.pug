extends ../../layouts/admin.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title Tài khoản quản trị
              p.text-muted.mb-0 Quản lý danh sách tài khoản quản trị.
            .col-auto
              a.btn.btn-primary(href="/admin/account-admin/create")
                i.las.la-plus.me-1
                | Tạo tài khoản
        .card-body.pt-0
          .table-responsive
            table.table.table-hover.align-middle.mb-0
              thead.table-light
                tr
                  th Họ tên
                  th Email
                  th Vai trò
                  th Trạng thái
                  th Đăng nhập gần nhất
                  th.text-end(style="min-width: 120px") Hành động
              tbody
                if accountList.length
                  each account in accountList
                    tr
                      td.fw-semibold #{account.fullName}
                      td #{account.email}
                      td
                        if account.role === "admin"
                          span.badge.text-bg-dark Admin
                        else
                          span.badge.text-bg-info Manager
                      td
                        if account.status === "active"
                          span.status-dot.text-success Hoạt động
                        else
                          span.status-dot.text-secondary Tạm dừng
                      td.text-muted.small
                        if account.lastLoginAt
                          | #{new Date(account.lastLoginAt).toLocaleString("vi-VN")}
                        else
                          | Chưa đăng nhập
                      td.text-end
                        .table-actions
                          a.btn-action.btn-action-edit(href=`/admin/account-admin/edit/${account._id}`, title="Chỉnh sửa tài khoản")
                            i.las.la-pen
                          button.btn-action.btn-action-delete.account-delete(type="button", data-id=account._id, title="Vô hiệu hóa tài khoản")
                            i.las.la-trash-alt
                else
                  tr
                    td.py-5.text-center.text-muted(colspan="6") Chưa có tài khoản quản trị.

block script
  script(src="/admin/assets/js/account-admin.js")
