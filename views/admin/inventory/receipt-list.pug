extends ../../layouts/admin.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
              p.text-muted.mb-0 Lịch sử các lần nhập hàng vào kho từ nhà cung cấp.
            .col-auto
              if canWrite
                a.btn.btn-primary(href=`/${pathAdmin}/inventory/receipt/create`)
                  i.las.la-plus.me-1
                  | Tạo phiếu nhập
        .card-body.pt-0
          form.row.g-2.mb-3(method="get", action=`/${pathAdmin}/inventory/receipt`)
            .col-md-4
              label.form-label.small Từ ngày
              input.form-control(type="text", data-datepicker, placeholder="dd/mm/yyyy", autocomplete="off", name="from", value=filters.from)
            .col-md-4
              label.form-label.small Đến ngày
              input.form-control(type="text", data-datepicker, placeholder="dd/mm/yyyy", autocomplete="off", name="to", value=filters.to)
            .col-md-4.d-flex.align-items-end.gap-2
              button.btn.btn-outline-primary.flex-grow-1(type="submit")
                i.las.la-search.me-1
                | Tìm kiếm
              a.btn.btn-outline-secondary.text-nowrap(href=`/${pathAdmin}/inventory/receipt/trash`, title="Xem danh sách phiếu nhập đã xóa mềm")
                i.las.la-archive.me-1
                | Lưu trữ
                if trashCount > 0
                  span.badge.bg-danger.ms-1 #{trashCount}

          .table-responsive
            table.table.table-hover.align-middle.mb-0
              thead.table-light
                tr
                  th Mã phiếu
                  th Nhà cung cấp
                  th Hóa đơn NCC
                  if canViewPurchasePrice
                    th.text-end Tổng chi phí
                  th Nhân viên liên hệ
                  th.text-center Số dòng
                  th Người tạo
                  th Thời gian
                  th.text-end(style="min-width: 140px") Hành động
              tbody
                if receiptList.length
                  each receipt in receiptList
                    tr
                      td
                        a.fw-semibold(href=`/${pathAdmin}/inventory/receipt/${receipt._id}`) #{receipt.receiptCode}
                      td
                        if receipt.supplierId
                          strong #{receipt.supplierId.name}
                        else
                          span.text-muted Không xác định
                      td
                        if receipt.hasInvoice
                          span.badge.bg-success-subtle.text-success(title="Có hóa đơn NCC")
                            i.las.la-file-invoice.me-1
                            | #{receipt.invoiceNumber || "Có HĐ"}
                        else
                          span.badge.bg-light.text-muted Không có HĐ
                      if canViewPurchasePrice
                        td.text-end.fw-bold.text-primary
                          | #{formatVND(receipt.totalCost || 0)}
                      td #{receipt.supplierContactName}
                      td.text-center
                        span.badge.bg-light.text-dark #{receipt.lineCount}
                      td #{receipt.createdBy ? receipt.createdBy.fullName : "Không xác định"}
                      td.text-muted.small #{new Date(receipt.createdAt).toLocaleString("vi-VN")}
                      td.text-end
                        .table-actions
                          a.btn-action.btn-action-view(href=`/${pathAdmin}/inventory/receipt/${receipt._id}`, title="Chi tiết phiếu nhập")
                            i.las.la-eye
                          if canManageReceipt
                            a.btn-action.btn-action-edit(href=`/${pathAdmin}/inventory/receipt/edit/${receipt._id}`, title="Sửa phiếu nhập")
                              i.las.la-pen
                            button.btn-action.btn-action-delete.receipt-soft-delete(type="button", data-id=receipt._id, title="Xóa mềm vào thùng rác")
                              i.las.la-trash-alt
                else
                  tr
                    td.text-center.text-muted.py-5(colspan=canViewPurchasePrice ? 9 : 8) Chưa có phiếu nhập kho.

          include ../../partials/pagination.pug

block script
  script(src="/admin/assets/js/receipt.js")
