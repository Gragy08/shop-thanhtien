extends ../../layouts/admin.pug

block main
  .row
    .col-12
      // Tiêu đề & thanh điều hướng nhanh
      .d-flex.justify-content-between.align-items-center.mb-3
        div
          h4.fw-bold.text-black.mb-0
            | Bán Hàng Tại Quầy
          p.text-muted.small.mb-0 Tạo đơn hàng bán lẻ tại quầy
        div.d-flex.gap-2
          a.btn.btn-outline-secondary.btn-sm(href=`/${pathAdmin}/order`)
            i.las.la-list.me-1
            | Danh sách đơn hàng
          a.btn.btn-outline-primary.btn-sm(href=`/${pathAdmin}/inventory`)
            i.las.la-boxes.me-1
            | Tồn kho

  .row.g-3
    // CỘT TRÁI: TÌM KIẾM SẢN PHẨM & GIỎ HÀNG (Chiếm 8/12 cột)
    .col-xl-8.col-lg-7
      // Ô tìm kiếm / quét mã vạch (z-index: 30 cao hơn giỏ hàng z-index: 1 nhưng thấp hơn Modal Bootstrap 1050/1055)
      .card.border.shadow-sm.mb-3(style="position: relative; z-index: 30;")
        .card-body.p-3
          .position-relative
            .input-group.input-group-lg
              span.input-group-text.bg-primary-subtle.text-primary
                i.las.la-barcode.fs-2
              input#posSearchInput.form-control.form-control-lg(
                type="text",
                placeholder="Quét mã IMEI/Serial trên hộp, hoặc gõ tên sản phẩm, SKU...",
                autocomplete="off",
                autofocus
              )
              button#btnClearSearch.btn.btn-outline-secondary(type="button", style="display: none;")
                i.las.la-times
              button#btnOpenCustomItemModal.btn.btn-info.fw-semibold.px-3.text-dark(type="button", title="Bán món lặt vặt hoặc tiền công dịch vụ không lưu kho")
                i.las.la-plus-circle.me-1.fs-5
                | Bán ngoài / Dịch vụ
            
            // Menu thả xuống hiển thị kết quả tìm kiếm sản phẩm (Nổi bật trên giỏ hàng, nền trắng đục hoàn toàn)
            #posSearchResults.dropdown-menu.w-100.p-2(
              style="position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 40; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; box-shadow: 0 15px 35px rgba(0,0,0,0.22); max-height: 420px; overflow-y: auto; display: none;"
            )
              // Kết quả đổ động qua JS

      // Bảng Giỏ hàng
      .card.border.shadow-sm(style="position: relative; z-index: 1;")
        .card-header.bg-light.py-2.d-flex.justify-content-between.align-items-center
          h6.mb-0.fw-bold.text-dark
            i.las.la-shopping-cart.me-1.text-primary
            | Giỏ hàng hiện tại (
            span#cartTotalItemsCount 0
            |  sản phẩm)
          button#btnResetCart.btn.btn-outline-danger.btn-sm.py-0(type="button", title="Xóa toàn bộ giỏ hàng")
            i.las.la-trash.me-1
            | Làm mới giỏ
        .card-body.p-0
          .table-responsive(style="min-height: 280px; max-height: 480px;")
            table.table.table-hover.align-middle.mb-0
              thead.table-light
                tr
                  th.text-center(style="width: 40px") #
                  th(style="min-width: 220px") Sản phẩm & Phiên bản
                  th.text-end(style="min-width: 120px") Đơn giá
                  th.text-center(style="min-width: 110px") Số lượng
                  th(style="min-width: 200px") IMEI / Serial xuất bán
                  th.text-end(style="min-width: 120px") Thành tiền
                  th.text-center(style="width: 50px")
              tbody#cartTableBody
                // Đổ dữ liệu động qua JS
                tr#cartEmptyRow
                  td.text-center.text-muted.py-5(colspan="7")
                    i.las.la-shopping-cart.fs-1.d-block.mb-2.text-muted.opacity-50
                    span.fw-semibold Giỏ hàng đang trống
                    p.small.text-muted.mb-0 Quét trực tiếp mã IMEI trên máy hoặc tìm sản phẩm ở ô phía trên để thêm vào đơn.

    // CỘT PHẢI: KHÁCH HÀNG & THANH TOÁN (Chiếm 4/12 cột)
    .col-xl-4.col-lg-5
      // Thẻ Thông tin khách hàng
      .card.border.shadow-sm.mb-3
        .card-header.bg-light.py-2
          h6.mb-0.fw-bold.text-dark
            i.las.la-user.me-1.text-primary
            | Thông tin khách mua hàng
        .card-body.p-3
          .mb-2
            label.form-label.small.mb-1 Số điện thoại*
            .input-group.input-group-sm
              span.input-group-text
                i.las.la-phone
              input#customerPhone.form-control(type="text", placeholder="Ví dụ: 0912345678...")
            #customerLookupBadge.mt-1(style="display: none;")
          .mb-2
            label.form-label.small.mb-1 Tên khách hàng*
            .input-group.input-group-sm
              span.input-group-text
                i.las.la-user-circle
              input#customerName.form-control(type="text", placeholder="Khách lẻ vãng lai", value="Khách lẻ vãng lai")
          .mb-0
            label.form-label.small.mb-1 Địa chỉ (tùy chọn)
            input#customerAddress.form-control.form-control-sm(type="text", placeholder="Địa chỉ giao/nhận...")

      // Thẻ Thanh toán & Xuất hóa đơn
      .card.border.shadow-sm
        .card-header.bg-light.py-2
          h6.mb-0.fw-bold.text-dark
            i.las.la-receipt.me-1.text-primary
            | Thanh toán đơn hàng
        .card-body.p-3
          // Tổng tiền hàng
          .d-flex.justify-content-between.align-items-center.mb-2
            span.text-muted Tổng tiền hàng:
            strong#subTotalDisplay.fs-6 0 đ

          // Chiết khấu / Giảm giá
          .d-flex.justify-content-between.align-items-center.mb-2
            div
              span.text-muted Giảm giá / Chiết khấu:
              button#btnRoundDiscount.btn.btn-link.btn-sm.p-0.ms-2.text-decoration-none(
                type="button",
                title="Tự động bớt số tiền lẻ để hóa đơn tròn nghìn đồng"
              )
                i.las.la-magic.me-1
                | [Làm tròn bill]
            .input-group.input-group-sm(style="width: 150px;")
              input#orderDiscountInput.form-control.text-end(type="text", format-money, value="0", placeholder="0")
              span.input-group-text đ

          hr.my-2

          // Tổng số tiền khách cần thanh toán
          .d-flex.justify-content-between.align-items-center.mb-3
            span.fw-bold.text-dark.fs-6 KHÁCH PHẢI TRẢ:
            h4#totalAmountDisplay.fw-bold.text-primary.mb-0 0 đ

          // Phương thức thanh toán
          .mb-3
            label.form-label.small.fw-bold.mb-1 Phương thức thanh toán
            .row.g-1
              .col-4
                input#payCash.btn-check(type="radio", name="paymentMethod", value="cash", checked)
                label.btn.btn-outline-primary.btn-sm.w-100.d-flex.align-items-center.justify-content-center.gap-1.py-2(for="payCash")
                  i.las.la-money-bill-wave
                  | Tiền mặt
              .col-4
                input#payBank.btn-check(type="radio", name="paymentMethod", value="bank_transfer")
                label.btn.btn-outline-primary.btn-sm.w-100.d-flex.align-items-center.justify-content-center.gap-1.py-2(for="payBank")
                  i.las.la-qrcode
                  | Chuyển khoản
              .col-4
                input#payInstallment.btn-check(type="radio", name="paymentMethod", value="installment")
                label.btn.btn-outline-primary.btn-sm.w-100.d-flex.align-items-center.justify-content-center.gap-1.py-2(for="payInstallment")
                  i.las.la-handshake
                  | Trả góp

          // Khối thông tin Hồ sơ Trả góp (Hiển thị khi chọn phương thức Trả góp)
          #installmentSection.p-3.border.border-warning.rounded.bg-warning-subtle.bg-opacity-10.mb-3(style="display: none;")
            .fw-bold.text-dark.small.mb-2 Thông tin hồ sơ trả góp bên thứ 3
            .mb-2
              label.form-label.small.mb-1(for="installmentProvider") Đơn vị tài chính liên kết *
              select#installmentProvider.form-select.form-select-sm
                option(value="home_credit") Home Credit
                option(value="mirae_asset") Mirae Asset
                option(value="hd_saison") HD Saison (Ngân hàng HD Sài Gòn)

            .row.g-2.mb-2
              .col-7
                label.form-label.small.mb-1(for="installmentCccd") Số CCCD khách hàng *
                input#installmentCccd.form-control.form-control-sm(
                  type="text",
                  maxlength="12",
                  placeholder="Nhập 9 - 12 số CCCD...",
                  autocomplete="off"
                )
              .col-5
                label.form-label.small.mb-1(for="installmentTermMonths") Kỳ hạn góp
                select#installmentTermMonths.form-select.form-select-sm
                  option(value="3") 3 tháng
                  option(value="6", selected) 6 tháng
                  option(value="9") 9 tháng
                  option(value="12") 12 tháng
                  option(value="15") 15 tháng
                  option(value="18") 18 tháng
                  option(value="24") 24 tháng

            .mb-2
              label.form-label.small.mb-1(for="installmentContractCode") Mã hợp đồng (hoặc bổ sung sau)
              input#installmentContractCode.form-control.form-control-sm.text-uppercase(
                type="text",
                placeholder="Để trống nếu bổ sung sau...",
                autocomplete="off"
              )

            .mb-2
              label.form-label.small.mb-1(for="installmentDownPayment") Tiền khách trả trước (VNĐ)
              .input-group.input-group-sm
                input#installmentDownPayment.form-control.text-end.fw-bold(
                  type="text",
                  format-money,
                  value="0",
                  placeholder="0"
                )
                span.input-group-text đ
              .d-flex.gap-1.mt-1.flex-wrap
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-downpayment(type="button", data-percent="0") 0 đ
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-downpayment(type="button", data-percent="10") 10%
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-downpayment(type="button", data-percent="20") 20%
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-downpayment(type="button", data-percent="30") 30%
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-downpayment(type="button", data-percent="50") 50%

            #downPaymentMethodBox.mb-2(style="display: none;")
              label.form-label.small.mb-1 Hình thức thu khoản trả trước
              .d-flex.gap-3
                .form-check
                  input#dpMethodCash.form-check-input(type="radio", name="downPaymentMethod", value="cash", checked)
                  label.form-check-label.small(for="dpMethodCash") Tiền mặt
                .form-check
                  input#dpMethodBank.form-check-input(type="radio", name="downPaymentMethod", value="bank_transfer")
                  label.form-check-label.small(for="dpMethodBank") Chuyển khoản

            .p-2.bg-white.border.rounded.mb-2
              .d-flex.justify-content-between.align-items-center
                span.small.text-muted Đối tác giải ngân (100%):
                strong#installmentLoanDisplay.fs-6.text-primary 0 đ

            .mb-0
              label.form-label.small.mb-1(for="installmentNote") Ghi chú hồ sơ góp (tùy chọn)
              input#installmentNote.form-control.form-control-sm(
                type="text",
                placeholder="VD: Tên nhân viên tài chính duyệt hồ sơ..."
              )

          #cashTenderSection
            // Tiền khách đưa
            .mb-2
              .d-flex.justify-content-between.align-items-center.mb-1
                label#paidAmountLabel.form-label.small.mb-0 Tiền khách đưa (VNĐ)
                button#btnExactAmount.btn.btn-link.btn-sm.p-0.text-decoration-none(type="button") [Đúng số tiền]
              input#paidAmountInput.form-control.text-end.fw-bold(type="text", format-money, placeholder="Nhập tiền khách đưa...")
              // Các nút tiền nhanh
              .d-flex.gap-1.mt-1.flex-wrap
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-cash(type="button", data-amount="500000") 500k
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-cash(type="button", data-amount="1000000") 1tr
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-cash(type="button", data-amount="2000000") 2tr
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-cash(type="button", data-amount="5000000") 5tr
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-cash(type="button", data-amount="10000000") 10tr

            // Tiền thừa trả khách & Tùy chọn xử lý tiền lẻ
            .p-2.bg-light.rounded.mb-3
              .d-flex.justify-content-between.align-items-center
                span.small.fw-bold.text-muted Tiền thừa trả lại:
                strong#changeAmountDisplay.fs-6.text-success 0 đ
              #keepSmallChangeContainer.mt-2.pt-2.border-top(style="display: none;")
                .form-check
                  input#keepSmallChangeCheck.form-check-input(type="checkbox")
                  label.form-check-label.small.text-secondary(for="keepSmallChangeCheck")
                    | Khách tặng lại / Không nhận tiền lẻ thừa (
                    strong#smallChangeAmountText 0 đ
                    | )

          // Ghi chú đơn hàng
          .mb-3
            label.form-label.small.mb-1 Ghi chú đơn hàng (tùy chọn)
            textarea#orderNote.form-control(rows="2", placeholder="Ghi chú thêm về đơn hàng hoặc yêu cầu khách...")

          // Nút thanh toán lớn
          .d-grid
            button#btnCheckout.btn.btn-success.btn-lg.fw-bold.py-3.shadow-sm(type="button")
              i.las.la-check-circle.fs-4.me-1
              | THANH TOÁN &amp; XUẤT HÓA ĐƠN

          p#posMessage.form-message.mt-2.mb-0.text-center

  // Modal Chọn IMEI / Serial cho dòng sản phẩm trong giỏ
  #selectImeiModal.modal.fade(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-dialog-centered.modal-lg
      .modal-content
        .modal-header.bg-light
          div
            h5.modal-title.fw-bold.text-primary.d-inline-block Chọn mã IMEI / Serial xuất bán
            span#modalImeiProductName.ms-2.text-dark.fw-semibold
          button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
        .modal-body
          .alert.alert-info.d-flex.justify-content-between.align-items-center.py-2.px-3.mb-3
            span
              i.las.la-info-circle.me-1
              | Yêu cầu chọn đúng 
              strong#modalRequiredCount 1
              |  mã thiết bị trong kho:
            span
              | Đã chọn: 
              strong#modalSelectedCount 0
              |  / 
              span#modalMaxCount 1
          
          .input-group.input-group-sm.mb-3
            span.input-group-text
              i.las.la-search
            input#modalImeiSearch.form-control(type="text", placeholder="Lọc tìm nhanh trong danh sách IMEI có sẵn...")

          #modalImeiList.d-flex.flex-wrap.gap-2.p-3.bg-light.rounded.border(style="max-height: 320px; overflow-y: auto;")
            // Các chip IMEI được render động tại đây

        .modal-footer.bg-light
          button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Hủy
          button#btnConfirmImeis.btn.btn-primary(type="button")
            i.las.la-check.me-1
            | Xác nhận chọn

  // Modal Thêm Món Bán Ngoài / Dịch Vụ Nhanh (Không lưu kho)
  #customItemModal.modal.fade(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header.bg-light
          h5.modal-title.fw-bold.text-dark
            i.las.la-plus-circle.text-info.me-1
            | Bán Ngoài / Dịch Vụ Nhanh
          button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
        .modal-body
          form#customItemForm
            .mb-3
              label.form-label.fw-bold Phân loại hình thức *
              .d-flex.gap-2
                .form-check.form-check-inline.border.rounded.p-2.px-3.flex-grow-1
                  input#typeCustomProduct.form-check-input(type="radio", name="customItemType", value="custom_product", checked)
                  label.form-check-label.fw-semibold.ms-1(for="typeCustomProduct")
                    | Mặt hàng lặt vặt
                  small.d-block.text-muted.mt-1 Nón bảo hiểm, Ốp lưng, bao da,...
                .form-check.form-check-inline.border.rounded.p-1.px-3.flex-grow-1
                  input#typeCustomService.form-check-input(type="radio", name="customItemType", value="custom_service")
                  label.form-check-label.fw-semibold.ms-1(for="typeCustomService")
                    | Tiền công / Dịch vụ
                  small.d-block.text-muted.mt-1 Dán màn hình, vệ sinh máy, cài đặt...

            .mb-3
              label.form-label.fw-bold(for="customProductName") Tên mặt hàng / Dịch vụ *
              input#customProductName.form-control(type="text", placeholder="Ví dụ: Dán màn hình cường lực iPhone 15", required, autocomplete="off")
              // Gợi ý chọn nhanh
              .d-flex.gap-1.flex-wrap.mt-1
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-custom-name(type="button", data-name="Dán cường lực", data-price="100000", data-type="custom_service") Dán cường lực
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-custom-name(type="button", data-name="Ốp lưng", data-price="100000", data-type="custom_product") Ốp lưng
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-custom-name(type="button", data-name="Vệ sinh máy", data-price="50000", data-type="custom_service") Vệ sinh máy
                button.btn.btn-sm.btn-light.border.py-0.px-2.btn-quick-custom-name(type="button", data-name="Cắt sim / Cài đặt", data-price="30000", data-type="custom_service") Cắt sim / Cài đặt

            .row.g-2.mb-3
              .col-6
                label.form-label.fw-bold(for="customUnitPrice") Giá bán cho khách *
                .input-group
                  input#customUnitPrice.form-control.text-end.fw-bold(type="text", format-money, placeholder="50.000", required)
                  span.input-group-text đ
              .col-6
                label.form-label.fw-bold(for="customQuantity") Số lượng *
                input#customQuantity.form-control.text-center.fw-bold(type="number", min="1", value="1", required)

            .mb-3
              label.form-label.small.text-muted(for="customPurchasePrice")
                | Giá vốn ước tính (Tùy chọn)
              .input-group.input-group-sm
                input#customPurchasePrice.form-control.text-end(type="text", format-money, placeholder="0")
                span.input-group-text đ
              small.text-muted Mặc định là 0 đ.

        .modal-footer.bg-light
          button.btn.btn-light(type="button", data-bs-dismiss="modal") Hủy
          button#btnAddCustomItem.btn.btn-info.fw-bold.px-4.text-dark(type="button")
            i.las.la-plus-circle.me-1
            | Thêm vào đơn hàng

block script
  script(src="/admin/assets/js/order-pos.js")
