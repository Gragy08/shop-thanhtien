extends ../../layouts/admin.pug

block main
  .row
    .col-12
      // Tiêu đề & thanh điều hướng
      .d-flex.justify-content-between.align-items-center.mb-3
        div
          h4.fw-bold.text-black.mb-0
            | Tiếp Nhận Thiết Bị Bảo Hành &amp; Sửa Chữa
          p.text-muted.small.mb-0 Lập phiếu tiếp nhận bảo hành.
        div.d-flex.gap-2
          a.btn.btn-outline-secondary.btn-sm(href=`/${pathAdmin}/warranty`)
            i.las.la-arrow-left.me-1
            | Danh sách phiếu
          a.btn.btn-outline-primary.btn-sm(href=`/${pathAdmin}/inventory/tracker`)
            i.las.la-barcode.me-1
            | Tra cứu IMEI

  // KHỐI 1: Ô TRA CỨU NHANH THEO IMEI / SERIAL HOẶC SỐ ĐIỆN THOẠI
  .row.mb-3
    .col-12
      .card.border.shadow-sm
        .card-header.bg-primary-subtle.py-2
          h6.mb-0.fw-bold.text-primary
            i.las.la-search.me-1
            | Bước 1: Quét mã IMEI hoặc Tra cứu số điện thoại khách hàng
        .card-body.p-3
          .input-group.input-group-lg
            span.input-group-text.bg-light
              i.las.la-barcode.fs-3.text-primary
            input#quickLookupInput.form-control.form-control-lg(
              type="text",
              placeholder="Quét mã IMEI trên máy, hoặc gõ SĐT khách hàng đã mua...",
              autofocus,
              autocomplete="off"
            )
            button#btnQuickLookup.btn.btn-primary.px-4(type="button")
              i.las.la-search.me-1
              | Tra cứu thông tin

          // Khu vực hiển thị kết quả tra cứu động
          #lookupResultContainer.mt-3(style="display: none;")

  // KHỐI 2: FORM LẬP PHIẾU TIẾP NHẬN BẢO HÀNH
  .row
    .col-12
      .card.border.shadow-sm
        .card-header.bg-light.py-3
          .d-flex.justify-content-between.align-items-center
            h6.mb-0.fw-bold.text-dark
              i.las.la-file-alt.me-1.text-primary
              | Bước 2: Thông tin phiếu tiếp nhận bảo hành
            .form-check.mb-0
              input#checkExternalDevice.form-check-input(type="checkbox")
              label.form-check-label.small.text-secondary(for="checkExternalDevice")
                | Máy ngoài cửa hàng (Sửa dịch vụ tính phí)
        
        .card-body.p-4
          form#warrantyForm
            // Phần 1: Thông tin thiết bị
            h6.text-primary.border-bottom.pb-2.mb-3
              i.las.la-info.me-1
              | 1. Thông tin thiết bị tiếp nhận
            .row.g-3.mb-4
              .col-md-5
                .d-flex.justify-content-between.align-items-center.mb-1
                  label.form-label.fw-bold.mb-0
                    | Mã IMEI / Serial thiết bị 
                    span.text-danger *
                  button#btnGenTempCode.btn.btn-link.btn-sm.p-0.text-decoration-none(
                    type="button",
                    title="Bấm nếu máy chết nguồn, mất khay SIM hoặc không rõ IMEI để tự sinh mã dịch vụ"
                  )
                    i.las.la-magic.me-1
                    | Không rõ IMEI (Tạo mã tạm)
                .input-group
                  span.input-group-text
                    i.las.la-barcode
                  input#inputIdentifier.form-control.font-monospace.fw-bold(
                    type="text",
                    name="identifier",
                    placeholder="Quét hoặc nhập mã IMEI / Serial...",
                    required
                  )
                  button#btnGenTempCodeInside.btn.btn-outline-primary(
                    type="button",
                    title="Tự động sinh mã tiếp nhận sửa chữa"
                  )
                    i.las.la-random.me-1
                    | Sinh mã
              .col-md-4
                label.form-label.fw-bold
                  | Tên sản phẩm 
                  span.text-danger *
                input#inputProductName.form-control(
                  type="text",
                  name="productName",
                  placeholder="Ví dụ: iPhone 15 Pro Max",
                  required
                )
              .col-md-3
                label.form-label Phiên bản / Màu sắc
                input#inputVariantName.form-control(
                  type="text",
                  name="variantName",
                  placeholder="Ví dụ: Titan Tự Nhiên / 256GB"
                )
              .col-md-4
                label.form-label Tình trạng bảo hành
                .d-flex.gap-2.align-items-center.mt-1
                  .form-check
                    input#warrantyStatusTrue.form-check-input(type="radio", name="isUnderWarranty", value="true", checked)
                    label.form-check-label.text-success.fw-bold(for="warrantyStatusTrue")
                      i.las.la-shield-alt.me-1
                      | Còn hạn bảo hành
                  .form-check
                    input#warrantyStatusFalse.form-check-input(type="radio", name="isUnderWarranty", value="false")
                    label.form-check-label.text-danger.fw-bold(for="warrantyStatusFalse")
                      i.las.la-times-circle.me-1
                      | Hết hạn / Sửa dịch vụ
              .col-md-4
                label.form-label Ngày mua ban đầu
                input#inputPurchaseDate.form-control(type="text", name="purchaseDate", placeholder="--", readonly)
              .col-md-4
                label.form-label Mã hóa đơn mua (nếu có)
                input#inputOrderCode.form-control(type="text", name="orderCode", placeholder="HD-...", readonly)

            // Phần 2: Thông tin khách hàng
            h6.text-primary.border-bottom.pb-2.mb-3
              i.las.la-user.me-1
              | 2. Thông tin khách hàng gửi máy
            .row.g-3.mb-4
              .col-md-4
                label.form-label.fw-bold
                  | Số điện thoại liên hệ 
                  span.text-danger *
                .input-group
                  span.input-group-text
                    i.las.la-phone
                  input#inputCustomerPhone.form-control.font-monospace(
                    type="text",
                    name="phone",
                    placeholder="Ví dụ: 0912345678",
                    required
                  )
              .col-md-4
                label.form-label.fw-bold
                  | Họ và tên khách hàng 
                  span.text-danger *
                .input-group
                  span.input-group-text
                    i.las.la-user
                  input#inputCustomerName.form-control(
                    type="text",
                    name="fullName",
                    placeholder="Ví dụ: Nguyễn Văn A",
                    required
                  )
              .col-md-4
                label.form-label Địa chỉ (tùy chọn)
                input#inputCustomerAddress.form-control(
                  type="text",
                  name="address",
                  placeholder="Địa chỉ cư trú hoặc nơi nhận lại máy..."
                )

            // Phần 3: Tình trạng máy & Mô tả lỗi
            h6.text-primary.border-bottom.pb-2.mb-3
              i.las.la-exclamation-triangle.me-1
              | 3. Tình trạng lỗi &amp; Ngoại quan khi tiếp nhận
            .row.g-3.mb-4
              .col-12
                label.form-label.fw-bold
                  | Mô tả hiện tượng lỗi / Yêu cầu của khách 
                  span.text-danger *
                textarea#inputIssueDescription.form-control(
                  name="issueDescription",
                  rows="3",
                  placeholder="Ví dụ: Màn hình bị sọc xanh dọc, thi thoảng mất nguồn sạc không vào, camera sau bị mờ...",
                  required
                )
              .col-md-4
                label.form-label Tình trạng ngoại quan thân vỏ
                input#inputPhysicalCondition.form-control(
                  type="text",
                  name="physicalCondition",
                  value="Máy bình thường, không cấn móp",
                  placeholder="Mô tả trầy xước, cấn góc, nứt kính nếu có..."
                )
              .col-md-4
                label.form-label Phụ kiện nhận kèm theo máy
                input#inputAccessories.form-control(
                  type="text",
                  name="accessoriesAttached",
                  value="Thân máy",
                  placeholder="Thân máy, củ sạc, dây cáp, ốp lưng, que chọc sim..."
                )
              .col-md-4
                label.form-label Mật khẩu máy / Mã PIN (để kỹ thuật test máy)
                .input-group
                  span.input-group-text
                    i.las.la-key
                  input#inputPasscode.form-control(
                    type="text",
                    name="passcode",
                    placeholder="Mã PIN hoặc 'Không có'"
                  )

            // Phần 4: Lịch hẹn & Dự kiến chi phí
            h6.text-primary.border-bottom.pb-2.mb-3
              i.las.la-calendar-check.me-1
              | 4. Lịch hẹn trả máy &amp; Dự toán chi phí
            .row.g-3.mb-4
              .col-md-4
                label.form-label.fw-bold Ngày hẹn trả máy dự kiến
                .input-group
                  span.input-group-text
                    i.las.la-calendar
                  input#inputExpectedReturnDate.form-control(type="text", data-datepicker, placeholder="dd/mm/yyyy", autocomplete="off", name="expectedReturnDate")
              .col-md-4
                label.form-label.fw-bold Chi phí sửa chữa dự kiến (VNĐ)
                .input-group
                  input#inputRepairCost.form-control.text-end.fw-bold(
                    type="text",
                    format-money,
                    name="repairCost",
                    value="0"
                  )
                  span.input-group-text đ
                small.text-muted Nhập 0 đ nếu thuộc diện bảo hành chính hãng miễn phí.
              .col-md-4
                label.form-label Ghi chú nội bộ cho kỹ thuật viên
                input#inputTechnicianNotes.form-control(
                  type="text",
                  name="technicianNotes",
                  placeholder="Lưu ý kỹ thuật, chỉ định linh kiện cần thay..."
                )

            // Nút hành động
            .d-flex.justify-content-end.gap-2.pt-3.border-top
              a.btn.btn-secondary(href=`/${pathAdmin}/warranty`) Hủy bỏ
              button#btnSubmitWarranty.btn.btn-success.btn-lg.fw-bold.px-4(type="submit")
                i.las.la-check-circle.fs-4.me-1
                | LẬP PHIẾU TIẾP NHẬN &amp; IN PHIẾU HẸN

block script
  script(src="/admin/assets/js/warranty-create.js")

