extends ../layouts/blank.pug

block main
  style.
    body {
      background: linear-gradient(135deg, #f0fdf4 0%, #e2e8f0 100%);
      min-height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .hero-banner {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #fff;
      padding: 40px 20px 60px;
      border-radius: 0 0 30px 30px;
      box-shadow: 0 10px 25px rgba(5, 150, 105, 0.2);
    }
    .lookup-card {
      margin-top: -35px;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.08);
      border: 1px solid rgba(0,0,0,0.05);
    }
    .timeline-steps {
      display: flex;
      justify-content: space-between;
      position: relative;
      margin: 25px 0 15px;
    }
    .timeline-steps::before {
      content: "";
      position: absolute;
      top: 15px;
      left: 30px;
      right: 30px;
      height: 3px;
      background: #e2e8f0;
      z-index: 1;
    }
    .step-item {
      position: relative;
      z-index: 2;
      text-align: center;
      flex: 1;
    }
    .step-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #e2e8f0;
      color: #64748b;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 6px;
      border: 2px solid #fff;
    }
    .step-item.active .step-icon {
      background: #10b981;
      color: #fff;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }
    .step-item.current .step-icon {
      background: #0ea5e9;
      color: #fff;
      animation: pulse 1.8s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.6); }
      70% { box-shadow: 0 0 0 8px rgba(14, 165, 233, 0); }
      100% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0); }
    }

  // Header thương hiệu
  .hero-banner.text-center
    .container(style="max-width: 760px;")
      h3.fw-bold.mb-1 SHOP THANH TIỀN
      p.mb-0.opacity-75 Trung Tâm Dịch Vụ Khách Hàng &amp; Tra Cứu Bảo Hành Thiết Bị Chính Hãng

  .container.pb-5(style="max-width: 820px;")
    // Khung tìm kiếm
    .card.bg-white.lookup-card.p-4.mb-4
      form(method="get", action="/tra-cuu-bao-hanh")
        h5.fw-bold.text-dark.mb-3.text-center
          i.las.la-search.text-success.me-2
          | Tra cứu thời hạn bảo hành &amp; Tiến độ sửa chữa
        
        .input-group.input-group-lg.shadow-sm
          span.input-group-text.bg-light.border-end-0
            i.las.la-barcode.fs-3.text-success
          input.form-control.border-start-0.ps-0(
            type="text",
            name="q",
            value=query,
            placeholder="Nhập mã IMEI/Serial thiết bị hoặc số điện thoại mua hàng...",
            required,
            autofocus
          )
          button.btn.btn-success.px-4.fw-bold(type="submit")
            i.las.la-search.me-1
            | TRA CỨU NGAY

        small.text-muted.d-block.mt-2.text-center
          i.las.la-info-circle.me-1
          | Bấm 
          code *#06#
          |  trên máy hoặc soi viền khay SIM để xem mã IMEI 15 chữ số.

    // Hiển thị kết quả tra cứu
    if result
      if result.found
        // Card 1: Thông tin thiết bị & Thời hạn bảo hành
        .card.bg-white.border-0.shadow-sm.rounded-4.p-4.mb-4
          .d-flex.justify-content-between.align-items-start.flex-wrap.gap-2.border-bottom.pb-3.mb-3
            div
              span.badge.bg-success-subtle.text-success.border.border-success-subtle.mb-1
                i.las.la-check-circle.me-1
                | Thiết bị chính hãng
              h4.fw-bold.text-dark.mb-1 #{result.productName}
              if result.variantName
                p.text-muted.mb-0 Phiên bản: #{result.variantName}
            
            div.text-sm-end
              div.small.text-muted Mã IMEI / Serial:
              span.font-monospace.fw-bold.fs-5.text-primary #{result.identifier}

          .row.g-3.align-items-center
            .col-md-7
              .p-3.rounded-3.bg-light
                .d-flex.justify-content-between.small.mb-2
                  span.text-muted Mã hóa đơn mua:
                  strong.font-monospace #{result.orderCode || "Bán tại quầy"}
                .d-flex.justify-content-between.small.mb-2
                  span.text-muted Ngày kích hoạt mua:
                  strong #{result.purchaseDate ? new Date(result.purchaseDate).toLocaleDateString("vi-VN") : "--"}
                .d-flex.justify-content-between.small
                  span.text-muted Ngày hết hạn bảo hành:
                  strong #{result.expiryDate ? new Date(result.expiryDate).toLocaleDateString("vi-VN") : "--"}
            
            .col-md-5.text-center
              if result.isUnderWarranty
                .p-3.rounded-3.bg-success-subtle.border.border-success
                  i.las.la-shield-alt.fs-1.text-success.d-block.mb-1
                  h6.fw-bold.text-success.mb-1 CÒN HẠN BẢO HÀNH
                  span.small.text-dark Còn 
                    strong.text-success #{result.daysLeft} ngày
                    |  bảo hành chính hãng
              else
                .p-3.rounded-3.bg-danger-subtle.border.border-danger
                  i.las.la-times-circle.fs-1.text-danger.d-block.mb-1
                  h6.fw-bold.text-danger.mb-1 HẾT HẠN BẢO HÀNH
                  span.small.text-muted Hỗ trợ sửa chữa dịch vụ tính phí ưu đãi

        // Card 2: Lịch sử & Tiến độ xử lý phiếu bảo hành
        if result.tickets && result.tickets.length
          .card.bg-white.border-0.shadow-sm.rounded-4.p-4.mb-4
            h5.fw-bold.text-dark.mb-3
              i.las.la-tools.text-primary.me-2
              | Tiến độ xử lý bảo hành &amp; Sửa chữa (#{result.tickets.length} phiếu)

            each tk, idx in result.tickets
              .border.rounded-3.p-3.mb-3.bg-light-subtle
                .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.border-bottom.pb-2.mb-3
                  div
                    span.fw-bold.text-primary.fs-6 #{tk.ticketCode}
                    span.text-muted.small.ms-2 (Tiếp nhận: #{tk.receivedDate ? new Date(tk.receivedDate).toLocaleString("vi-VN") : "--"})
                  div
                    case tk.ticketStatus
                      when "received"
                        span.badge.bg-primary-subtle.text-primary Mới tiếp nhận
                      when "in_progress"
                        span.badge.bg-warning-subtle.text-warning-emphasis Đang xử lý sửa chữa
                      when "completed"
                        span.badge.bg-info-subtle.text-info Đã sửa xong (Chờ khách lấy)
                      when "delivered"
                        span.badge.bg-success-subtle.text-success Đã bàn giao nhận máy
                      when "cancelled"
                        span.badge.bg-danger-subtle.text-danger Đã hủy phiếu

                // Thanh tiến trình trực quan
                if tk.ticketStatus !== "cancelled"
                  .timeline-steps
                    .step-item.active
                      .step-icon 1
                      .small.fw-bold.text-dark Tiếp nhận
                    .step-item(class=(tk.ticketStatus === "in_progress" || tk.ticketStatus === "completed" || tk.ticketStatus === "delivered" ? "active" : "") class=(tk.ticketStatus === "in_progress" ? "current" : ""))
                      .step-icon 2
                      .small.fw-bold.text-dark Đang sửa
                    .step-item(class=(tk.ticketStatus === "completed" || tk.ticketStatus === "delivered" ? "active" : "") class=(tk.ticketStatus === "completed" ? "current" : ""))
                      .step-icon 3
                      .small.fw-bold.text-dark Đã xong
                    .step-item(class=(tk.ticketStatus === "delivered" ? "active" : ""))
                      .step-icon 4
                      .small.fw-bold.text-dark Đã nhận máy

                // Thông tin chi tiết phiếu
                .row.g-2.mt-2.small
                  .col-md-6
                    strong.text-danger Hiện tượng lỗi khách báo: 
                    span.text-dark #{tk.issueDescription}
                  .col-md-6
                    strong.text-dark Hẹn trả máy: 
                    span #{tk.expectedReturnDate ? new Date(tk.expectedReturnDate).toLocaleDateString("vi-VN") : "Liên hệ sau"}
                  
                  if tk.isExchange1to1
                    .col-12.mt-2
                      .alert.alert-success.py-2.px-3.mb-0.small
                        i.las.la-sync-alt.me-1.fw-bold
                        strong ĐÃ ĐỔI MỚI 1-ĐỔI-1: 
                        span Đã xuất đổi thiết bị mới nguyên bản có mã IMEI: 
                        strong.font-monospace.text-primary #{tk.replacementIdentifier}
                        if tk.replacementProductName
                          span  (#{tk.replacementProductName})
                  
                  if tk.replacedParts
                    .col-12.mt-1
                      strong.text-primary Linh kiện đã thay thế: 
                      span #{tk.replacedParts}
                      if tk.partsWarrantyMonths
                        span.badge.bg-info-subtle.text-info.ms-2 Bảo hành linh kiện #{tk.partsWarrantyMonths} tháng
                  
                  if tk.handoverNotes
                    .col-12.mt-1
                      strong.text-muted Ghi chú bàn giao: 
                      span #{tk.handoverNotes}

      else
        // Không tìm thấy
        .card.bg-white.border-0.shadow-sm.rounded-4.p-4.mb-4.text-center
          i.las.la-search-minus.fs-1.text-warning.mb-2
          h5.fw-bold.text-dark Không tìm thấy thông tin thiết bị
          p.text-muted.small #{result.message}
          div.pt-2
            a.btn.btn-outline-success.btn-sm(href="/tra-cuu-bao-hanh")
              i.las.la-redo.me-1
              | Thử tra cứu lại

    // Khung hỗ trợ & Hotline
    .card.bg-white.border-0.shadow-sm.rounded-4.p-4.text-center
      h6.fw-bold.text-dark.mb-1 Cần hỗ trợ kỹ thuật hoặc kiểm tra trực tiếp?
      p.small.text-muted.mb-3 Đội ngũ kỹ thuật viên Shop Thanh Tiền luôn sẵn sàng giải đáp mọi thắc mắc của bạn.
      .d-flex.justify-content-center.gap-3.flex-wrap
        a.btn.btn-outline-success.btn-sm(href="tel:0988000000")
          i.las.la-phone.me-1
          | Hotline Kỹ Thuật: 0988.xxx.xxx
        a.btn.btn-outline-primary.btn-sm(href=`/${pathAdmin}/account/login`, title="Đăng nhập quản trị viên")
          i.las.la-user-shield.me-1
          | Cổng Quản Trị Shop

