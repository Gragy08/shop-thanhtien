#modalFileManager.modal.fade(tabindex="-1" aria-hidden="true")
  .modal-dialog.modal-xl.modal-dialog-centered
    .modal-content
      .modal-header.py-2
        h5.modal-title
          i.las.la-photo-video.text-primary.me-1
          | Thư viện hình ảnh & tệp tin
        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
      .modal-body.p-0
        iframe#iframeFileManager(
          src=`/${pathAdmin}/file-manager/iframe`
          frameborder="0"
          style="width: 100%; height: 75vh; display: block;"
        )

