.startbar.d-print-none
  .brand
    a.logo(href=`/${pathAdmin}/dashboard`)
      span
        img.logo-sm(alt="logo-small" src="/admin/assets/images/logo-sm.png")
      span
        img.logo-lg.logo-light(alt="logo-large" src="/admin/assets/images/logo-light.png" style="max-width: 120px; height: auto; padding-top: 15px;")
        img.logo-lg.logo-dark(alt="logo-large" src="/admin/assets/images/logo-light.png" style="max-width: 120px; height: auto; padding-top: 15px;")
  .startbar-menu
    #startbarCollapse.startbar-collapse(data-simplebar="")
      .d-flex.align-items-start.flex-column.w-100
        ul.navbar-nav.mb-auto.w-100
          li.nav-item
            a.nav-link(href=`/${pathAdmin}/dashboard`)
              i.iconoir-home-simple.menu-icon
              span Tổng quan
          if permissions.includes("product:read") || permissions.includes("admin:all")
            li.nav-item
              a.nav-link(aria-controls="sidebarProduct" aria-expanded="false" role="button" data-bs-toggle="collapse" href="#sidebarProduct")
                i.iconoir-shop.menu-icon
                span Sản phẩm
              #sidebarProduct.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/product`) Danh sách sản phẩm
                  if permissions.includes("product:write") || permissions.includes("admin:all")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/product/create`) Tạo sản phẩm
                  if permissions.includes("category:write") || permissions.includes("admin:all")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/product/category`) Danh mục sản phẩm
                  if permissions.includes("attribute:write") || permissions.includes("admin:all")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/product/attribute`) Thuộc tính sản phẩm
          if permissions.includes("inventory:read") || permissions.includes("admin:all")
            li.nav-item
              a.nav-link(aria-controls="sidebarInventory" aria-expanded="false" role="button" data-bs-toggle="collapse" href="#sidebarInventory")
                i.iconoir-box.menu-icon
                span Kho hàng
              #sidebarInventory.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/inventory`) Tồn kho
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/inventory/tracker`) Tra cứu IMEI / Serial
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/inventory/receipt`) Danh sách phiếu nhập
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/inventory/receipt/create`) Phiếu nhập kho
                  if permissions.includes("supplier:read") || permissions.includes("admin:all")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/inventory/supplier`) Nhà cung cấp
          if permissions.includes("order:read") || permissions.includes("admin:all")
            li.nav-item
              a.nav-link(aria-controls="sidebarOrder" aria-expanded="false" role="button" data-bs-toggle="collapse" href="#sidebarOrder")
                i.iconoir-shopping-bag.menu-icon
                span Bán hàng & Đơn hàng
              #sidebarOrder.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/order/pos`) Bán hàng tại quầy
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/order`) Danh sách đơn hàng
          if permissions.includes("customer:read") || permissions.includes("admin:all")
            li.nav-item
              a.nav-link(aria-controls="sidebarCustomer" aria-expanded="false" role="button" data-bs-toggle="collapse" href="#sidebarCustomer")
                i.iconoir-community.menu-icon
                span Khách hàng
              #sidebarCustomer.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/customer`) Danh sách khách hàng
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/customer/create`) Thêm khách hàng
          if permissions.includes("warranty:read") || permissions.includes("admin:all")
            li.nav-item
              a.nav-link(aria-controls="sidebarWarranty" aria-expanded="false" role="button" data-bs-toggle="collapse" href="#sidebarWarranty")
                i.iconoir-wrench.menu-icon
                span Bảo hành & Sửa chữa
              #sidebarWarranty.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/warranty`) Danh sách phiếu bảo hành
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/warranty/create`) Tiếp nhận bảo hành
                  li.nav-item
                    a.nav-link(href="/tra-cuu-bao-hanh" target="_blank") Tra cứu bảo hành (Portal)
          if permissions.includes("admin:all")
            li.nav-item
              a.nav-link(aria-controls="sidebarAccountAdmin" aria-expanded="false" role="button" data-bs-toggle="collapse" href="#sidebarAccountAdmin")
                i.iconoir-user-crown.menu-icon
                span Tài khoản quản trị
              #sidebarAccountAdmin.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/account-admin/create`) Tạo tài khoản
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/account-admin/list`) Danh sách tài khoản
          if permissions.includes("media:read") || permissions.includes("admin:all")
            li.nav-item
              a.nav-link(href=`/${pathAdmin}/file-manager`)
                i.iconoir-page-star.menu-icon
                span Quản lý file
          li.nav-item
            a.nav-link(href="#")
              i.iconoir-settings.menu-icon
              span Cài đặt
