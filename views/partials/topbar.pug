.topbar.d-print-none
  .container-xxl
    nav#topbar-custom.topbar-custom.d-flex.justify-content-between
      ul.topbar-item.list-unstyled.d-inline-flex.align-items-center.mb-0
        li
          button#togglemenu.nav-link.mobile-menu-btn.nav-icon(type="button" aria-label="Thu gọn menu")
            i.iconoir-menu-scale
        li.mx-3.welcome-text
          h3.mb-0.fw-bold.text-truncate Xin chào, #{accountAdmin.fullName}!
      ul.topbar-item.list-unstyled.d-inline-flex.align-items-center.mb-0
        li.topbar-item
          a#light-dark-mode.nav-link.nav-icon(href="javascript:void(0);" aria-label="Đổi giao diện")
            i.icofont-moon.dark-mode
            i.icofont-sun.light-mode
        li.dropdown.topbar-item
          a.nav-link.dropdown-toggle.arrow-none.nav-icon(href="#" data-bs-toggle="dropdown" aria-expanded="false")
            span.avatar-initial #{accountAdmin.fullName.substring(0, 1).toUpperCase()}
          .dropdown-menu.dropdown-menu-end.py-0
            .d-flex.align-items-center.dropdown-item.py-2.bg-secondary-subtle
              .avatar-initial.me-2 #{accountAdmin.fullName.substring(0, 1).toUpperCase()}
              .text-truncate
                h6.my-0.fw-medium.text-dark.fs-13 #{accountAdmin.fullName}
                small.text-muted
                  if accountAdmin.role === "admin"
                    | Quản trị viên
                  else if accountAdmin.role === "manager"
                    | Quản lý
                  else
                    | Nhân viên
            .dropdown-divider.mt-0
            if permissions && (permissions.includes("admin:all") || permissions.includes("account:manage"))
              a.dropdown-item(href=`/${pathAdmin}/account-admin/list`)
                i.las.la-user-cog.fs-18.me-1.align-text-bottom
                | Tài khoản quản trị
              .dropdown-divider.mb-0
            form(method="post" action=`/${pathAdmin}/account/logout`)
              button.dropdown-item.text-danger(type="submit")
                i.las.la-power-off.fs-18.me-1.align-text-bottom
                | Đăng xuất
